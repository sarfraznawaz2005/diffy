<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diffy.App.Views.AboutWindow"
        Title="About Diffy"
        Width="350" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full">
    
    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Diffy"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="VersionTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="A Git Watcher App"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            <TextBlock Text="Built with .NET 8 &amp; Avalonia UI"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Button Grid.Row="1" 
                Content="Close" 
                Classes="DialogButton"
                HorizontalAlignment="Center" 
                Click="OkButton_Click"/>
    </Grid>
</Window>
