## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Visual Studio cache/options directory
.vs/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/

# Visual Studio Code
.vscode/

# Avalonia specific
*.axaml.designer.cs

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results of other tools
bin/
obj/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# BenchmarkDotNet
*.benchmarkDotNet

# Coverlet files
coverage/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
*.lnk
desktop.ini

# Logs
*.log
logs/
dist/

Diffy.lnk
build_errors.txt
output.txt
commands.txt
manual-testing.md
releasing.md
todos.txt

# GitHub
screenshots/

# Release artifacts
*.zip
*.tar.gz
*.dmg
*.exe
*.msi
*.AppImage
